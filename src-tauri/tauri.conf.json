{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TodoList AI",
  "version": "0.1.0",
  "identifier": "com.todolistai.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TodoList AI",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "AI daily planner for macOS",
    "longDescription": "A macOS native todo app: an AI agent plans your day every morning (calendar-aware, priority-ranked time blocks). Local-first, SQLite storage, optional local models via Ollama.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}